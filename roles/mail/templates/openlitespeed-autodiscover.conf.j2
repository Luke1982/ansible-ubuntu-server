# {{ ansible_managed }}
# OpenLiteSpeed template for autoconfig.DOMAIN and autodiscover.DOMAIN: the
# settings for mail.DOMAIN, for Thunderbird and Outlook. Each domain is a member
# named autodiscover.DOMAIN with autoconfig.DOMAIN as alias, added by "mailctl
# autodiscover publish DOMAIN".
{% if item.https %}
# On the HTTP and HTTPS listeners, with the member's own Let's Encrypt
# certificate (certbot --cert-name autodiscover.DOMAIN).
{% else %}
# On the HTTP listeners only: for members that don't have their certificate yet.
# certbot gets it through this site.
{% endif %}
allowSymbolLink           0
enableScript              1
restrained                1
setUIDMode                0
vhRoot                    {{ autodiscover_root }}/
configFile                $SERVER_ROOT/conf/vhosts/$VH_NAME/vhconf.conf

virtualHostConfig  {
  docRoot                 $VH_ROOT
  enableGzip              1

  errorlog  {
    useServer             1
  }

  index  {
    useServer             0
    autoIndex             0
    indexFiles            index.html
  }

  # PHP answers the mail programs: the scripts only read the request. They all
  # share one set of PHP processes, on the socket below.
  #
  # The block is part of the template, so every member -- a domain each -- has a
  # copy of it, and each copy opens the same socket. Connections are therefore
  # not kept open (persistConn 0): with persistent connections the first copy
  # held both processes for itself, and every request for another domain waited
  # for them until it timed out ("Reached max children process limit: 2" in
  # OpenLiteSpeed's error.log). Defining the processor once in
  # httpd_config.conf instead would make a copy per member unnecessary.
  #
  # The memory limits have to leave room for the opcache: it is 128 MB of
  # shared memory that every process is counted for in full, so under a limit
  # of 320M lsphp died on every start ("Unable to allocate shared memory
  # segment of 134217728 bytes: mmap: Cannot allocate memory" in stderr.log),
  # requests hung with "possible dead lock", and Outlook gave up waiting.
  extprocessor mailautodiscover-php {
    type                  lsapi
    address               uds://tmp/lshttpd/mailautodiscover.sock
    maxConns              4
    env                   PHP_LSAPI_CHILDREN=8
    initTimeout           60
    retryTimeout          0
    persistConn           0
    respBuffer            0
    autoStart             1
    path                  {{ autodiscover_lsphp }}
    backlog               100
    instances             1
    memSoftLimit          1024M
    memHardLimit          1200M
  }

  scripthandler  {
    add                   lsapi:mailautodiscover-php php
  }

  # Outlook posts to /autodiscover/autodiscover.xml (in any case); Thunderbird
  # asks for /mail/config-v1.1.xml. Besides the scripts, the web root only
  # holds certbot's challenges.
{% if item.https %}
  # /apple is the page where somebody with an Apple device gets a profile for
  # their mail. It is here and not on the HTTP template: a profile holds the
  # account's settings, and isn't handed out over a connection nobody checks.
{% endif %}
  rewrite  {
    enable                1
    rules                 <<<END_rules
RewriteRule ^/autodiscover/autodiscover\.xml$ /autodiscover.php [NC,L]
RewriteRule ^/(\.well-known/autoconfig/)?mail/config-v1\.1\.xml$ /autoconfig.php [NC,L]
{% if item.https %}
RewriteRule ^/apple/?$ /apple.php [NC,L]
{% endif %}
    END_rules
  }
{% if item.https %}

  vhssl  {
    keyFile               /etc/letsencrypt/live/$VH_NAME/privkey.pem
    certFile              /etc/letsencrypt/live/$VH_NAME/fullchain.pem
    certChain             1
  }
{% endif %}
}
