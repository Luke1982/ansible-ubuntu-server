#!/bin/bash
# The mail certificate: the hostname and the mail.DOMAIN names (mailctl
# certificate sync). Both read it again when they reload, so mail programs never
# get the expired one.
case "$RENEWED_LINEAGE" in
        */{{hostname}}) doveadm reload >/dev/null; postfix reload >/dev/null ;;
esac

# The webmail sites (mailctl webmail sync) and the autodiscover sites (mailctl
# autodiscover publish): OpenLiteSpeed reads certificates when it starts.
case "$RENEWED_LINEAGE" in
        */webmail.*|*/autodiscover.*) {{ ols_root }}/bin/lswsctrl restart </dev/null >/dev/null 2>&1 ;;
esac
