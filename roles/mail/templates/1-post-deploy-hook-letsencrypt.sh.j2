#!/bin/bash
for domain in $RENEWED_DOMAINS
do
        if [ "$domain" = {{hostname}} ]
        then
                doveadm reload >/dev/null
        fi
done

# The webmail sites (mailctl webmail sync) and the autodiscover sites (mailctl
# autodiscover publish): OpenLiteSpeed reads certificates when it starts.
case "$RENEWED_LINEAGE" in
        */webmail.*|*/autodiscover.*) {{ ols_root }}/bin/lswsctrl restart >/dev/null ;;
esac