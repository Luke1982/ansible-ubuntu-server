use_bayes                   1
bayes_auto_learn            1
# Off: expiring locks the database while it runs, and with millions of tokens that held up every message being
# checked until sending timed out. The nightly cron job (tasks/configure-spamassassin.yml) expires instead.
bayes_auto_expire           0

bayes_store_module          Mail::SpamAssassin::BayesStore::MySQL

bayes_sql_dsn               DBI:mysql:bayes:127.0.0.1:3306
bayes_sql_username          mailuser
bayes_sql_password          {{mailuser_db_pass}}

bayes_sql_override_username vmail
