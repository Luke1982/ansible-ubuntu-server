## Folder names mail clients make themselves. When a message is saved (APPEND)
# or copied/moved (COPY) into one, an IMAPSieve script moves it on to Sent,
# Trash or Junk, so each kind of mail stays in one folder whatever client is
# used. Drafts are left alone: a client must find its draft back.
# Spam learning from the same events is in 95-imapsieve-spam.conf.
sieve_plugins {
  sieve_imapsieve = yes
}
# Remove the message from the client's folder right away, instead of only
# flagging it \Deleted until the client expunges.
imapsieve_expunge_discarded = yes
{% for target, folders in dovecot_client_folder_names.items() %}
{% for folder in folders %}
mailbox "{{ folder }}" {
  sieve_script to-{{ target }} {
    type = before
    cause = append copy
    path = {{ dovecot_imapsieve_dir }}/to-{{ target }}.sieve
  }
}
{% endfor %}
{% endfor %}
