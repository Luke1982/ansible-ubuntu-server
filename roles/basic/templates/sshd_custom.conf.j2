# Who may log in over SSH.
#
# Ansible wrote this file once, when the server had none, and never writes it
# again: who may log in changes on the server itself -- a site user given SFTP,
# somebody who left -- and none of that is a playbook's to decide. Add and remove
# names on the AllowUsers line here, then: systemctl reload ssh
#
# It started with the users from linuxusers.yml that have ssh_access, the backup
# user (ssh_always_allowed), and Ansible's own user ({{ ansible_user }}), which
# is on the line so a run can never lock Ansible out.
PermitRootLogin no
AllowUsers {{ ssh_allowed_users | join(' ') }}
