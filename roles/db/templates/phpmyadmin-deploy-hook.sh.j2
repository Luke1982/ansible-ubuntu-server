#!/bin/bash
# {{ ansible_managed }}
# The certificate of the phpMyAdmin site ({{ phpmyadmin_host }}): OpenLiteSpeed
# reads certificates when it starts, so a renewed one only reaches visitors
# after a restart. Graceful: requests in progress are finished first.
case "$RENEWED_LINEAGE" in
        */{{ phpmyadmin_host }}) {{ ols_root }}/bin/lswsctrl restart </dev/null >/dev/null 2>&1 ;;
esac
