# {{ ansible_managed }}
# The settings of the phpMyAdmin site at {{ phpmyadmin_host }}. OpenLiteSpeed's
# listeners and its other sites are set up by hand in WebAdmin; the db role puts
# this site in its config (pmasite.py) and writes this file, where WebAdmin keeps
# a site's settings, so WebAdmin shows it like any other.
docRoot                   {{ phpmyadmin_root }}/
enableGzip                1
{% if phpmyadmin_certificate_live %}

# The site's own certificate, which certbot got through the site itself.
vhssl  {
  keyFile                 {{ phpmyadmin_certificate_live }}/privkey.pem
  certFile                {{ phpmyadmin_certificate_live }}/fullchain.pem
  certChain               1
}
{% endif %}

errorlog  {
  useServer               1
}

index  {
  useServer               0
  autoIndex               0
  indexFiles              index.php
}

# LiteSpeed's PHP runs phpMyAdmin, as OpenLiteSpeed's own user: the site has no
# user of its own (setUIDMode 0 in the server config).
extprocessor phpmyadmin-php  {
  type                    lsapi
  address                 uds://tmp/lshttpd/phpmyadmin.sock
  maxConns                5
  env                     PHP_LSAPI_CHILDREN=5
  initTimeout             60
  retryTimeout            0
  persistConn             1
  respBuffer              0
  autoStart               1
  path                    {{ phpmyadmin_lsphp }}
  backlog                 100
  instances               1
  memSoftLimit            512M
  memHardLimit            640M
}

scripthandler  {
  add                     lsapi:phpmyadmin-php php
}

# The database password travels with every request, so the site is only offered
# over HTTPS. Let's Encrypt's challenges stay on HTTP, for a certificate of its
# own later on: without one the site uses the certificate of the HTTPS listener.
rewrite  {
  enable                  1
  rules                   <<<END_rules
RewriteCond %{HTTPS} !on
RewriteCond %{REQUEST_URI} !^/\.well-known/acme-challenge/
RewriteRule ^ https://{{ phpmyadmin_host }}%{REQUEST_URI} [R=301,L]
  END_rules
}

# Let's Encrypt's challenges, for the site's own certificate. They are the only
# thing the site answers over plain HTTP.
context /.well-known/acme-challenge/  {
  location                {{ phpmyadmin_root }}/.well-known/acme-challenge/
  allowBrowse             1
}

# phpMyAdmin's own directories: no page lives in them, and setup writes settings.
context /libraries/  {
  allowBrowse             0
}

context /templates/  {
  allowBrowse             0
}

context /vendor/  {
  allowBrowse             0
}

context /setup/  {
  allowBrowse             0
}

context /tmp/  {
  allowBrowse             0
}

# LiteSpeed's page cache stays off, so one person's pages are never served to another.
module cache  {
  ls_enabled              0
}
