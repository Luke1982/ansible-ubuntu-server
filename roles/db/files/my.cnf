# Ansible writes this file only when the server doesn't have one yet (roles/db/tasks/main.yml), so
# anything changed here stays changed. Tuning for the machine itself is better kept in a file of its
# own under /etc/mysql/mariadb.conf.d/, which MariaDB reads after this one.
[mysqld]
max_connections = 500
max_user_connections = 200
default-authentication-plugin=mysql_native_password
